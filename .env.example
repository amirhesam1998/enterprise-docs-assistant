# Copy to .env and adjust. docker compose reads .env automatically.
# Every value here has a working default in docker-compose.yml — this file exists
# so a real deployment can override the ones that matter.

# --- Auth / RBAC ---
# Change this for anything other than a local demo.
SECRET_KEY=dev-only-change-me
TOKEN_MINUTES=60
DEFAULT_TENANT=public
CREATOR_USERNAME=creator
CREATOR_PASSWORD=creator123
CREATOR_EMAIL=creator@example.com

# --- Ollama (runs on the HOST, not in Docker) ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b-local

# --- Frontend origin (CORS) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Hugging Face cache ---
# Mounted into the API container so bge-m3 is not re-downloaded.
# Windows example: C:/Users/<you>/.cache/huggingface
HF_CACHE_DIR=~/.cache/huggingface

# --- Qdrant (host-run scripts only) ---
# The API gets http://qdrant:6333 from compose; scripts on the host use this.
QDRANT_URL=http://localhost:6333

# --- Redis / Celery (host-run scripts only) ---
# The API and worker get redis://redis:6379/0 from compose; host scripts use this.
REDIS_URL=redis://localhost:6379/0

# --- OCR (image ingestion) ---
# Only needed when the tesseract binary is not on PATH. The worker image installs
# it, so leave this unset for Docker; set it when running a worker on a Windows
# host, e.g. C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSERACT_CMD=